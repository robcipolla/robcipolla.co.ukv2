---
import Logo from "@components/Logo.astro";
import LinkedIn from "@components/icons/LinkedIn.astro";
import X from "@components/icons/X.astro";
import Github from "@components/icons/Github.astro";
import Menu from "@components/icons/Menu.astro";
import CloseMenu from "@components/icons/CloseMenu.astro";

const currentPath = Astro.url.pathname;
const navLinks = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Writing", href: "/blog" },
];

const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 lg:px-8">
    <a id="header-logo" href="/" class="relative z-10 flex min-h-11 min-w-11 items-center" aria-label="Rob Cipolla, home">
      <Logo variant="light" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary navigation">
      <ul class="flex items-center gap-7">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class="nav-link text-sm font-semibold text-white/75 transition-colors hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:underline-offset-8"
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-1" aria-label="Social links">
        <a class="social-link flex h-11 w-11 items-center justify-center text-white/65 transition-colors hover:text-white" href="https://www.linkedin.com/in/rob-cipolla" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">LinkedIn</span>
          <LinkedIn class="h-4 w-4" />
        </a>
        <a class="social-link flex h-11 w-11 items-center justify-center text-white/65 transition-colors hover:text-white" href="https://x.com/robcipolla" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">X</span>
          <X class="h-4 w-4" />
        </a>
        <a class="social-link flex h-11 w-11 items-center justify-center text-white/65 transition-colors hover:text-white" href="https://github.com/robcipolla" target="_blank" rel="noopener noreferrer">
          <span class="sr-only">GitHub</span>
          <Github class="h-4 w-4" />
        </a>
      </div>

      <a
        id="contact-button"
        class="rounded border border-white/35 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white hover:text-charcoal"
        href="/contact"
        aria-current={currentPath.startsWith("/contact") ? "page" : undefined}
      >
        Contact
      </a>
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="relative z-50 flex h-11 w-11 items-center justify-center rounded border border-white/30 text-white lg:hidden"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <Menu id="open-menu-icon" class="h-5 w-5" />
      <CloseMenu id="close-menu-icon" class="hidden h-5 w-5" />
    </button>
  </div>
</header>

<nav
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col justify-center bg-charcoal px-6 pt-20 lg:!hidden"
  aria-label="Mobile navigation"
  aria-hidden="true"
  hidden
>
  <ul class="flex flex-col border-t border-white/15">
    {navLinks.map((link) => (
      <li class="border-b border-white/15">
        <a
          data-mobile-link
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          class="flex min-h-16 items-center text-2xl font-semibold text-white/80 aria-[current=page]:text-white"
        >
          {link.name}
        </a>
      </li>
    ))}
    <li class="border-b border-white/15">
      <a
        data-mobile-link
        href="/contact"
        aria-current={currentPath.startsWith("/contact") ? "page" : undefined}
        class="flex min-h-16 items-center text-2xl font-semibold text-white/80 aria-[current=page]:text-white"
      >Contact</a>
    </li>
  </ul>

  <div class="mt-8 flex items-center gap-2">
    <a data-mobile-link class="flex h-12 w-12 items-center justify-center text-white/65" href="https://www.linkedin.com/in/rob-cipolla" target="_blank" rel="noopener noreferrer">
      <span class="sr-only">LinkedIn</span>
      <LinkedIn class="h-5 w-5" />
    </a>
    <a data-mobile-link class="flex h-12 w-12 items-center justify-center text-white/65" href="https://x.com/robcipolla" target="_blank" rel="noopener noreferrer">
      <span class="sr-only">X</span>
      <X class="h-5 w-5" />
    </a>
    <a data-mobile-link class="flex h-12 w-12 items-center justify-center text-white/65" href="https://github.com/robcipolla" target="_blank" rel="noopener noreferrer">
      <span class="sr-only">GitHub</span>
      <Github class="h-5 w-5" />
    </a>
  </div>
</nav>

<style>
  .header-scrolled {
    background: rgba(245, 245, 247, 0.98);
    border-bottom: 1px solid #d3d3d9;
  }

  .header-scrolled #header-logo :global(path) {
    fill: #17171c;
  }

  .header-scrolled .nav-link,
  .header-scrolled .social-link {
    color: #5f6069;
  }

  .header-scrolled .nav-link:hover,
  .header-scrolled .social-link:hover,
  .header-scrolled .nav-link[aria-current="page"] {
    color: #17171c;
  }

  .header-scrolled .social-link :global(path) {
    fill: currentColor;
  }

  .header-scrolled #contact-button {
    border-color: #17171c;
    background: #17171c;
    color: #ffffff;
  }

  .header-scrolled #contact-button:hover {
    background: transparent;
    color: #17171c;
  }

  .header-scrolled #mobile-menu-toggle {
    border-color: #d3d3d9;
    color: #17171c;
  }

  .header-scrolled #mobile-menu-toggle :global(path) {
    fill: currentColor;
  }

  .mobile-menu-open {
    background: #292930;
    border-bottom-color: transparent;
  }

  .mobile-menu-open #header-logo :global(path) {
    fill: #ffffff;
  }

  .mobile-menu-open #mobile-menu-toggle {
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }
</style>

<script is:inline>
  const header = document.getElementById("site-header");
  const menu = document.getElementById("mobile-menu");
  const menuButton = document.getElementById("mobile-menu-toggle");
  const openIcon = document.getElementById("open-menu-icon");
  const closeIcon = document.getElementById("close-menu-icon");
  const mobileLinks = menu?.querySelectorAll("[data-mobile-link]") ?? [];
  let menuOpen = false;

  const focusableSelector = "a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex='-1'])";

  function updateHeader() {
    header?.classList.toggle("header-scrolled", window.scrollY > 8 && !menuOpen);
  }

  function setMenu(open, restoreFocus = true) {
    if (!menu || !menuButton) return;

    menuOpen = open;
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.setAttribute("aria-hidden", String(!open));
    menu.hidden = !open;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    header?.classList.toggle("mobile-menu-open", open);
    document.body.classList.toggle("overflow-hidden", open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);

    if (open) {
      requestAnimationFrame(() => menu.querySelector("a")?.focus());
    } else if (restoreFocus) {
      menuButton.focus();
    }

    updateHeader();
  }

  menuButton?.addEventListener("click", () => setMenu(!menuOpen));

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setMenu(false, false));
  });

  document.addEventListener("keydown", (event) => {
    if (!menuOpen || !menu || !menuButton) return;

    if (event.key === "Escape") {
      event.preventDefault();
      setMenu(false);
      return;
    }

    if (event.key !== "Tab") return;

    const focusable = [menuButton, ...menu.querySelectorAll(focusableSelector)];
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });

  window.addEventListener("scroll", updateHeader, { passive: true });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024 && menuOpen) setMenu(false, false);
  });
  updateHeader();
</script>
