---
interface Props {
  title: string;
  date: string;
  company: string;
  year: string;
  last?: boolean;
}

const { title, date, company, year } = Astro.props;
---

<article class="grid gap-4 border-b border-border py-8 md:grid-cols-[7rem_1fr] md:gap-8">
  <div>
    <p class="text-sm font-semibold text-muted">{year}</p>
  </div>
  <div>
    <p class="text-sm text-muted">{date}</p>
    <h3 class="mt-2 text-xl font-bold tracking-[-0.02em] text-ink">{title}</h3>
    <p class="mt-1 font-semibold text-muted">{company}</p>
    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
      <slot />
    </div>
  </div>
</article>
