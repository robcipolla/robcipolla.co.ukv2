---
import LinkedIn from "@components/icons/LinkedIn.astro";
import recommendations from "@utils/constants/recommendations.json";

const [featured, ...others] = recommendations.recommendations;
---

<section class="bg-canvas">
  <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
    <h2 class="section-heading">What people say</h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <figure>
        <blockquote class="text-2xl font-semibold leading-snug tracking-[-0.025em] text-ink sm:text-3xl">
          "{featured.text}"
        </blockquote>
        <figcaption class="mt-7 flex items-center gap-3">
          <div>
            <p class="font-semibold text-ink">{featured.name}</p>
            <p class="mt-1 text-sm text-muted">{featured.role}</p>
          </div>
          <a class="flex h-11 w-11 items-center justify-center text-muted hover:text-ink" href={featured.link} target="_blank" rel="noopener noreferrer">
            <span class="sr-only">View {featured.name} on LinkedIn</span>
            <LinkedIn class="h-4 w-4" />
          </a>
        </figcaption>
      </figure>

      <div class="border-t border-border lg:border-t-0">
        {others.map((recommend) => (
          <figure class="border-b border-border py-7 first:pt-7 lg:first:pt-0">
            <blockquote class="text-base leading-relaxed text-muted">"{recommend.text}"</blockquote>
            <figcaption class="mt-5 flex items-start justify-between gap-4">
              <div>
                <p class="font-semibold text-ink">{recommend.name}</p>
                <p class="mt-1 text-sm text-muted">{recommend.role}</p>
              </div>
              <a class="flex h-11 w-11 shrink-0 items-center justify-center text-muted hover:text-ink" href={recommend.link} target="_blank" rel="noopener noreferrer">
                <span class="sr-only">View {recommend.name} on LinkedIn</span>
                <LinkedIn class="h-4 w-4" />
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-5 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-lg font-semibold text-ink">Want to know how I work before getting in touch?</p>
      <a class="btn-ghost shrink-0" href="/about">Read about my background</a>
    </div>
  </div>
</section>
