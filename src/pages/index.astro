---
import WhatPeopleSay from "@components/sections/WhatPeopleSay.astro";
import LancioMark from "@components/icons/LancioMark.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import profilePicture from "@assets/profile-picture-home.webp";
import inspiringLeadersImage from "@assets/lancio-studio/inspiring-leaders.webp";
import jamesWhitingImage from "@assets/lancio-studio/james-whiting-fitness.webp";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { compareDesc, format } from "date-fns";

const yearsExperience = new Date().getFullYear() - 2016;
const posts = await getCollection("blog");
const orderedPosts = posts.sort((a, b) =>
  compareDesc(new Date(a.data.date), new Date(b.data.date))
);
---

<SiteLayout
  title="Rob Cipolla | Product Engineer"
  description="Product engineer in Leicester, designing and building web products. Client projects are accepted through Lancio Studio."
  ogImage="/og/home.png"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Rob Cipolla",
    "url": "https://www.robcipolla.co.uk",
    "author": {
      "@type": "Person",
      "name": "Rob Cipolla",
      "jobTitle": "Product Engineer",
      "url": "https://www.robcipolla.co.uk",
      "sameAs": [
        "https://www.linkedin.com/in/rob-cipolla",
        "https://github.com/robcipolla",
        "https://x.com/robcipolla"
      ]
    }
  })} />

  <section class="bg-charcoal text-white">
    <div class="mx-auto grid min-h-[760px] max-w-5xl items-end gap-12 px-6 pb-14 pt-32 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:px-8 lg:pb-18 lg:pt-40">
      <div class="pb-2 lg:pb-8">
        <h1 class="max-w-3xl text-[clamp(3rem,7vw,5rem)] font-bold leading-[0.96] tracking-[-0.04em]">
          Product Engineer, <span class="font-normal text-white/70">noun</span>
        </h1>
        <p class="mt-4 text-lg text-white/65">PROD-ukt en-jih-NEER</p>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/78">
          I design and build web products. Most of the hard work happens before the code: deciding what belongs, what does not, and how the thing should behave.
        </p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-white/60">
          Based in Leicester, with {yearsExperience}+ years working across product design and full-stack development. Currently at <a class="font-semibold text-white underline decoration-white/35 underline-offset-4 hover:decoration-white" href="https://locale.co.uk">Locale</a>.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="btn btn-light" href="#work">See selected work</a>
          <a class="inline-flex min-h-11 items-center px-3 font-semibold text-white underline decoration-white/35 underline-offset-4 hover:decoration-white" href="/about">More about me</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:mx-0">
        <Image
          src={profilePicture}
          alt="Rob Cipolla standing beside a window"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 36vw, 90vw"
          class="aspect-[4/5] w-full rounded-[2px] object-cover object-center"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section id="work" class="bg-canvas">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-heading">Selected client work</h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
            Work completed through <a class="font-semibold text-ink underline underline-offset-4" href="https://lancio.studio" target="_blank" rel="noopener noreferrer">Lancio Studio</a>, where I take on projects outside my day job.
          </p>
        </div>
        <a class="text-link shrink-0" href="https://lancio.studio/work/" target="_blank" rel="noopener noreferrer">See all Lancio work <span aria-hidden="true">↗</span></a>
      </div>

      <div class="mt-14 space-y-20 lg:mt-18 lg:space-y-28">
        <article class="grid items-center gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14">
          <a href="https://lancio.studio/work/inspiring-leaders-today/" target="_blank" rel="noopener noreferrer" aria-label="Read the Inspiring Leaders case study at Lancio Studio">
            <Image
              src={inspiringLeadersImage}
              alt="The Inspiring Leaders CPD booking platform homepage"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="aspect-[16/9] w-full rounded-[2px] object-cover"
            />
          </a>
          <div>
            <p class="text-sm font-semibold text-muted">Web application</p>
            <h3 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-ink">Inspiring Leaders</h3>
            <p class="mt-5 text-base leading-relaxed text-muted">
              A CPD booking platform and admin system used across an East Midlands education partnership. I helped turn a manual process into one clear booking flow.
            </p>
            <a class="text-link mt-6" href="https://lancio.studio/work/inspiring-leaders-today/" target="_blank" rel="noopener noreferrer">Read the case study <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="grid items-center gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
          <div class="lg:order-1">
            <p class="text-sm font-semibold text-muted">Brand and website</p>
            <h3 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-ink">James Whiting Fitness</h3>
            <p class="mt-5 text-base leading-relaxed text-muted">
              A new identity and one-page website built around a single job: turning personal recommendations into consultation bookings.
            </p>
            <a class="text-link mt-6" href="https://lancio.studio/work/james-whiting-fitness/" target="_blank" rel="noopener noreferrer">Read the case study <span aria-hidden="true">↗</span></a>
          </div>
          <a class="lg:order-2" href="https://lancio.studio/work/james-whiting-fitness/" target="_blank" rel="noopener noreferrer" aria-label="Read the James Whiting Fitness case study at Lancio Studio">
            <Image
              src={jamesWhitingImage}
              alt="The James Whiting Fitness website homepage"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="aspect-[16/9] w-full rounded-[2px] object-cover object-top"
            />
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-heading">Recent writing</h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-muted">Notes on product engineering, interface decisions and the parts of development that are worth arguing about.</p>
        </div>
        <a class="text-link shrink-0" href="/blog">Browse all posts</a>
      </div>

      <div class="mt-12 border-t border-border">
        {orderedPosts.slice(0, 3).map((post) => (
          <article class="group grid gap-3 border-b border-border py-7 sm:grid-cols-[9rem_1fr_auto] sm:items-center">
            <time class="text-sm text-muted" datetime={post.data.date.toISOString()}>{format(post.data.date, "MMM d, yyyy")}</time>
            <h3 class="text-xl font-semibold leading-snug tracking-[-0.02em] text-ink">
              <a class="transition-opacity group-hover:opacity-65" href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <span class="hidden text-xl transition-transform group-hover:translate-x-1 sm:block" aria-hidden="true">→</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-soft">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-20 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-20 lg:px-8 lg:py-24">
      <div class="flex items-center gap-4">
        <LancioMark class="h-16 w-16 shrink-0" />
        <p class="text-xl font-bold tracking-[-0.02em]">Lancio Studio</p>
      </div>
      <div>
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.03em] sm:text-4xl">I take on client projects through Lancio.</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
          Lancio is the small studio I run alongside my product engineering work. We design and build websites, web apps and brands for growing businesses.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn" href="https://lancio.studio/contact/" target="_blank" rel="noopener noreferrer">Start a project <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="https://lancio.studio" target="_blank" rel="noopener noreferrer">Visit Lancio Studio</a>
        </div>
      </div>
    </div>
  </section>

  <WhatPeopleSay />
</SiteLayout>
