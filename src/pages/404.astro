---
import SiteLayout from "@layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" description="Page not found">
  <section class="bg-charcoal text-white">
    <div class="container py-32 lg:py-44">
      <h1 class="text-[clamp(3rem,7vw,5rem)] font-bold leading-[0.96] tracking-[-0.04em]">Page not found</h1>
      <p class="mt-6 text-xl text-white/65">There is nothing at this address.</p>
    </div>
  </section>

  <div class="container py-12">
    <a class="btn" href="/">← Go home</a>
  </div>
</SiteLayout>
