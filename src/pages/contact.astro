---
import SiteLayout from "@layouts/SiteLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import LancioMark from "@components/icons/LancioMark.astro";
---

<SiteLayout
  title="Contact | Rob Cipolla"
  description="Contact Rob Cipolla, or start a website, web app or brand project through Lancio Studio."
  ogImage="/og/contact.png"
>
  <section class="bg-charcoal text-white">
    <div class="mx-auto max-w-5xl px-6 pb-18 pt-32 lg:px-8 lg:pb-24 lg:pt-40">
      <h1 class="text-[clamp(3rem,7vw,5rem)] font-bold leading-[0.96] tracking-[-0.04em]">Contact</h1>
      <p class="mt-7 max-w-xl text-xl leading-relaxed text-white/70">
        Client projects go through Lancio Studio. For work, writing or anything else, you can contact me here.
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto grid max-w-5xl gap-16 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8 lg:py-28">
      <div>
        <div class="flex items-center gap-3">
          <LancioMark class="h-11 w-11" />
          <p class="text-lg font-bold">Lancio Studio</p>
        </div>
        <h2 class="mt-7 text-3xl font-bold leading-tight tracking-[-0.03em]">Starting a client project?</h2>
        <p class="mt-5 text-base leading-relaxed text-muted">
          Lancio handles my website, web app and brand projects. You do not need a finished brief. Tell us what you want to build or improve, and we will recommend what to do first.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted">Lancio replies within one working day.</p>
        <a class="btn mt-7" href="https://lancio.studio/contact/" target="_blank" rel="noopener noreferrer">Start a project <span aria-hidden="true">↗</span></a>
      </div>

      <div class="border-t border-border pt-10 lg:border-t-0 lg:pt-0">
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.03em]">Everything else</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
          Email <a class="font-semibold text-ink underline underline-offset-4" href="mailto:hello@robcipolla.co.uk">hello@robcipolla.co.uk</a>, or use the form. A little context helps, but a polished introduction is not required.
        </p>
        <div class="mt-8 max-w-xl">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
