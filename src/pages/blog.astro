---
import SiteLayout from "@layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { compareDesc, format } from "date-fns";

const posts = await getCollection("blog");
const orderedPosts = posts.sort((a, b) =>
  compareDesc(new Date(a.data.date), new Date(b.data.date))
);
---

<SiteLayout
  title="Writing | Rob Cipolla"
  description="Writing about product engineering, interface decisions, web development and the work behind the code."
  ogImage="/og/blog.png"
>
  <section class="bg-charcoal text-white">
    <div class="mx-auto max-w-5xl px-6 pb-18 pt-32 lg:px-8 lg:pb-24 lg:pt-40">
      <h1 class="text-[clamp(3rem,7vw,5rem)] font-bold leading-[0.96] tracking-[-0.04em]">Writing</h1>
      <p class="mt-7 max-w-xl text-xl leading-relaxed text-white/70">
        Notes on product engineering, interface decisions and the parts of development that are worth arguing about.
      </p>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto max-w-5xl px-6 py-16 lg:px-8 lg:py-24">
      <div class="border-t border-border">
        {orderedPosts.map((post) => (
          <article class="group grid gap-3 border-b border-border py-8 sm:grid-cols-[9rem_1fr_auto] sm:items-center">
            <time class="text-sm text-muted" datetime={post.data.date.toISOString()}>{format(post.data.date, "MMM d, yyyy")}</time>
            <div>
              <h2 class="text-xl font-semibold leading-snug tracking-[-0.02em] text-ink sm:text-2xl">
                <a class="transition-opacity group-hover:opacity-65" href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              {post.data.excerpt && <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{post.data.excerpt}</p>}
            </div>
            <span class="hidden text-xl transition-transform group-hover:translate-x-1 sm:block" aria-hidden="true">→</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
