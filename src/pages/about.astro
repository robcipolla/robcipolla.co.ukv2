---
import SiteLayout from "@layouts/SiteLayout.astro";
import TimelineContainer from "@components/TimelineContainer.astro";
import TimelineItem from "@components/TimelineItem.astro";
import profilePicture from "@assets/profile-about-page.webp";
import { Image } from "astro:assets";

const yearsExperience = new Date().getFullYear() - 2016;
---

<SiteLayout
  title="About | Rob Cipolla"
  description={`Product engineer with ${yearsExperience}+ years of experience across product design and full-stack development.`}
  ogImage="/og/about.png"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Rob Cipolla",
    "jobTitle": "Product Engineer",
    "url": "https://www.robcipolla.co.uk",
    "sameAs": [
      "https://www.linkedin.com/in/rob-cipolla",
      "https://github.com/robcipolla",
      "https://x.com/robcipolla"
    ]
  })} />

  <section class="bg-charcoal text-white">
    <div class="mx-auto grid max-w-5xl items-end gap-12 px-6 pb-14 pt-32 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-8 lg:pb-18 lg:pt-40">
      <div class="lg:order-2 lg:pb-8">
        <h1 class="text-[clamp(3rem,7vw,5rem)] font-bold leading-[0.96] tracking-[-0.04em]">About me</h1>
        <p class="mt-8 max-w-xl text-xl leading-relaxed text-white/75">
          I'm Rob. I design and build software, and I prefer working close to the problem instead of waiting for a finished specification.
        </p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-white/60">
          That has taken me through design, WordPress, full-stack applications, team leadership and product engineering. The job title changed. The useful part stayed the same: working out what to build and making it hold up.
        </p>
      </div>

      <Image
        src={profilePicture}
        alt="Rob Cipolla standing beside a window"
        widths={[520, 780, 1040]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/5] w-full rounded-[2px] object-cover lg:order-1"
        loading="eager"
      />
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-20 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20 lg:px-8 lg:py-28">
      <h2 class="section-heading">How I work</h2>
      <div class="max-w-2xl space-y-5 text-lg leading-relaxed text-muted">
        <p>
          I work across product decisions, interface design and full-stack development. React, TypeScript, Node and PHP are regular tools, but the framework is rarely the difficult part. The difficult part is choosing the right behaviour and leaving the code understandable for whoever works on it next.
        </p>
        <p>
          At Locale, I work as a senior full-stack developer with a strong frontend and product focus. For independent client work, I run <a class="font-semibold text-ink underline underline-offset-4" href="https://lancio.studio" target="_blank" rel="noopener noreferrer">Lancio Studio</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-20 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20 lg:px-8 lg:py-28">
      <h2 class="section-heading">How I got here</h2>
      <div class="max-w-2xl space-y-5 text-base leading-relaxed text-muted">
        <p>
          I started in game art and design, studying concept art, scriptwriting, 3D modelling and level design. I eventually realised I was more interested in making interactive things than building a career in games.
        </p>
        <p>
          I moved to Graphic Design and E-media at Leicester College and De Montfort University. A small JavaScript accordion in one coursework project was enough to pull me towards web development. I completed a further year in Professional Studies for the Creative Industries and graduated with First Class Honours.
        </p>
        <p>
          My first industry role involved building custom WordPress themes for small businesses. Since then I have worked on marketing sites, booking platforms, internal tools and full-stack products, both as an individual contributor and as a team lead.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-canvas">
    <div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <div>
          <h2 class="section-heading">Experience</h2>
          <p class="mt-5 max-w-xs text-base leading-relaxed text-muted">A condensed version. LinkedIn has the full chronology.</p>
          <a class="text-link mt-6" href="https://www.linkedin.com/in/rob-cipolla" target="_blank" rel="noopener noreferrer">View LinkedIn <span aria-hidden="true">↗</span></a>
        </div>

        <TimelineContainer>
          <TimelineItem title="Senior Full Stack Web Developer" date="2025 to present" company="Locale" year="2025">
            <p>Leading frontend decisions and contributing across the product, from interface behaviour to application architecture.</p>
            <p class="text-sm">React · Node.js · PHP · Laravel · MySQL · Docker · AWS</p>
          </TimelineItem>
          <TimelineItem title="Web Developer" date="June 2023 to 2025" company="Locale" year="2023">
            <p>Joined the product team to improve and extend a mix of established and new React and Laravel features.</p>
            <p class="text-sm">React · Node.js · PHP · Laravel · MySQL · Docker</p>
          </TimelineItem>
          <TimelineItem title="Head of Web" date="September 2019 to June 2023" company="Reach Marketing Communications" year="2019">
            <p>Led website delivery, mentored developers and moved the team towards version control, AWS hosting and component-led frontend work.</p>
            <p class="text-sm">React · Next.js · Astro · Node.js · TypeScript · AWS · WordPress</p>
          </TimelineItem>
          <TimelineItem title="Web Designer and Developer" date="November 2017 to July 2019" company="Success Local Limited" year="2017">
            <p>Designed and built custom WordPress websites for small businesses, taking projects from wireframe to launch.</p>
            <p class="text-sm">PHP · MySQL · WordPress · SCSS · JavaScript</p>
          </TimelineItem>
          <TimelineItem title="Freelance Web Designer" date="2015 to 2017" company="Rob Cipolla Design" year="2015">
            <p>Built WordPress themes and portfolio websites, including referred projects for university students.</p>
            <p class="text-sm">PHP · MySQL · WordPress · CSS · JavaScript</p>
          </TimelineItem>
        </TimelineContainer>
      </div>
    </div>
  </section>

  <section class="bg-soft">
    <div class="mx-auto flex max-w-5xl flex-col gap-7 px-6 py-16 sm:flex-row sm:items-center sm:justify-between lg:px-8 lg:py-20">
      <div>
        <h2 class="text-3xl font-bold tracking-[-0.03em]">Have something to talk about?</h2>
        <p class="mt-3 text-base text-muted">Work, product engineering, or the unusually hard parts of seemingly simple interfaces.</p>
      </div>
      <a class="btn shrink-0" href="/contact">Contact me</a>
    </div>
  </section>
</SiteLayout>
