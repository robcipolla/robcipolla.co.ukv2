---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: string;
}

const { title, description, ogImage, type = "website" } = Astro.props;
---

<html lang="en" class="scroll-smooth lg:scroll-pt-[100px]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="alternate" type="application/rss+xml" title="Rob Cipolla | Blog" href="/rss.xml" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="author" content="Rob Cipolla" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={`https://www.robcipolla.co.uk/${ogImage}`}
    />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={`https://www.robcipolla.co.uk/${ogImage}`}
    />
    <meta property="twitter:domain" content="robcipolla.co.uk" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <Font cssVariable="--font-dm-sans" preload />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas">
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-[60] -translate-y-24 rounded bg-white px-4 py-3 font-semibold text-ink transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
