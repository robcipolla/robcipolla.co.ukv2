---
import SiteLayout from "@layouts/SiteLayout.astro";
import { format } from "date-fns";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    excerpt: string;
    readingTime: number;
  };
  slug: string;
}

const { frontmatter, slug } = Astro.props;
const postedAt = format(frontmatter.date, "MMM d, yyyy");
---

<SiteLayout
  title={`${frontmatter.title} | Rob Cipolla`}
  description={frontmatter.description}
  ogImage={`/blog/${slug}/og.png`}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": frontmatter.title,
    "description": frontmatter.description,
    "datePublished": frontmatter.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Rob Cipolla",
      "url": "https://www.robcipolla.co.uk"
    },
    "image": `https://www.robcipolla.co.uk/blog/${slug}/og.png`
  })} />

  <section class="bg-charcoal text-white">
    <div class="mx-auto max-w-5xl px-6 pb-18 pt-32 lg:px-8 lg:pb-24 lg:pt-40">
      <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-white/55">
        <time datetime={frontmatter.date.toISOString()}>{postedAt}</time>
        <span aria-hidden="true">·</span>
        <span>{frontmatter.readingTime} min read</span>
      </div>
      <h1 class="mt-6 max-w-4xl text-[clamp(2.5rem,6vw,4.5rem)] font-bold leading-[0.98] tracking-[-0.04em]">
        {frontmatter.title}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/68">{frontmatter.excerpt}</p>
    </div>
  </section>

  <article class="bg-canvas">
    <div class="mx-auto max-w-3xl px-6 py-14 lg:px-8 lg:py-20">
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>

      <div class="mt-16 border-t border-border pt-8">
        <a href="/blog" class="btn-ghost">← Back to writing</a>
      </div>
    </div>
  </article>
</SiteLayout>
